{
  "name": "Cadrian Design Tokens",
  "version": "1.0.0",
  "token": {
    "black": "#000000",
    "ink": "#0A0A0A",
    "steel": "#3F3F3F",
    "grey-70": "#6E6E6E",
    "grey-55": "#8C8C8C",
    "grey-35": "#B5B5B5",
    "grey-20": "#D6D6D6",
    "canvas": "#E4E4E4",
    "paper": "#F2F0EE",
    "white": "#FFFFFF",
    "bg": "var(--cmc-canvas)",
    "surface": "var(--cmc-white)",
    "surface-inv": "var(--cmc-black)",
    "text": "var(--cmc-black)",
    "text-muted": "var(--cmc-grey-55)",
    "text-inv": "var(--cmc-white)",
    "rule": "var(--cmc-grey-20)",
    "particle": "var(--cmc-white)",
    "particle-inv": "var(--cmc-black)",
    "font": "\"Inter Tight\", \"Inter\", ui-sans-serif, system-ui,\n              -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif",
    "font-mono": "ui-monospace, \"SF Mono\", \"Roboto Mono\", Menlo, monospace",
    "w-light": "300",
    "w-book": "400",
    "w-medium": "500",
    "fs-display": "clamp(3.5rem, 1.5rem + 8vw, 8rem)",
    "fs-title": "clamp(2.25rem, 1.2rem + 4.2vw, 4.5rem)",
    "fs-h1": "clamp(1.75rem, 1.1rem + 2.6vw, 3rem)",
    "fs-h2": "clamp(1.375rem, 1rem + 1.5vw, 2rem)",
    "fs-lead": "clamp(1.0625rem, 0.95rem + 0.6vw, 1.375rem)",
    "fs-body": "1rem",
    "fs-small": "0.8125rem",
    "fs-micro": "0.6875rem",
    "lh-tight": "0.94",
    "lh-snug": "1.08",
    "lh-normal": "1.45",
    "tr-display": "-0.035em",
    "tr-title": "-0.025em",
    "tr-body": "-0.01em",
    "tr-micro": "0.02em",
    "sp-1": "0.25rem",
    "sp-2": "0.5rem",
    "sp-3": "0.75rem",
    "sp-4": "1rem",
    "sp-5": "1.5rem",
    "sp-6": "2rem",
    "sp-7": "3rem",
    "sp-8": "4rem",
    "sp-9": "6rem",
    "sp-10": "8rem",
    "gutter": "clamp(1.25rem, 3vw, 3rem)",
    "measure": "62ch",
    "max": "1440px",
    "r-mark": "22%",
    "r-card": "14px",
    "r-panel": "20px",
    "r-pill": "999px",
    "border": "1px solid var(--cmc-rule)",
    "shadow-0": "none",
    "shadow-1": "0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(0,0,0,.06)",
    "shadow-2": "0 2px 4px rgba(0,0,0,.08), 0 24px 60px rgba(0,0,0,.14)",
    "cell": "4px",
    "dither-min": "0.02",
    "dither-max": "1",
    "dither-jitter": "0.3",
    "ease": "cubic-bezier(.2,.7,.2,1)",
    "dur-fast": "180ms",
    "dur-base": "420ms",
    "dur-slow": "900ms",
    "dur-resolve": "1600ms",
    "z-base": "0",
    "z-sticky": "100",
    "z-overlay": "500"
  }
}